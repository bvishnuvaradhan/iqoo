# Production / Vercel Configuration
# Leave VITE_API_URL empty on Vercel so requests go to the same domain (e.g. /api)
# Set VITE_SOCKET_URL to 'disabled' on Vercel as serverless cannot handle persistent websockets
VITE_API_URL=
VITE_SOCKET_URL=disabled

# Local Development Configuration
# VITE_API_URL=http://localhost:8000
# VITE_SOCKET_URL=http://localhost:8000
